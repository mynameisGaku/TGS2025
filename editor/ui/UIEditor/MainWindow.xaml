<Window x:Class="MainCanvasEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MainCanvasEditor"
        mc:Ignorable="d"
        Title="MainCanvas JSON Editor" Width="1280" Height="800"
        Background="#1e1f22">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:SelectedToBrushConverter x:Key="BooleanToBrush"/>
        <local:SelectedThicknessConverter x:Key="SelectedThickness"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#f0f0f0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#f0f0f0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="#f0f0f0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
        </Style>

        <!-- グリッド柄（外側：少し暗め） -->
        <DrawingBrush x:Key="WorldGridBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#202326">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{x:Null}">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#2b2f34" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.5,0.5,31,31"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- グリッド柄（キャンバス内：少し明るめ） -->
        <DrawingBrush x:Key="CanvasGridBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#242629">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,32,32"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{x:Null}">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#34383e" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.5,0.5,31,31"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- メニュー -->
        <Menu Grid.Row="0" Panel.ZIndex="1000">
            <MenuItem Header="ファイル">
                <MenuItem Header="開く..." Click="OnOpenJsonClick"/>
                <MenuItem Header="保存" Click="OnSaveJsonClick"/>
                <Separator/>
                <MenuItem Header="終了" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="表示">
                <MenuItem Header="キャンバスを画面にフィット" Click="OnFitClick"/>
                <MenuItem Header="画面サイズに合わせて自動フィット"
                          IsCheckable="True"
                          IsChecked="{Binding AutoFitOnResize, Mode=TwoWay}"/>
                <MenuItem Header="ガイド表示" IsCheckable="True" IsChecked="{Binding ShowGuides, Mode=TwoWay}"/>
            </MenuItem>
            <MenuItem Header="編集">
                <MenuItem Header="UI要素を追加" Click="OnAddUIClick"/>
                <MenuItem Header="選択UIを複製" Click="OnDuplicateUIClick"/>
                <MenuItem Header="選択UIを削除" Click="OnDeleteUIClick"/>
            </MenuItem>
        </Menu>

        <!-- 本体 -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン：ビューポート -->
            <Border x:Name="ViewportHost"
                    Grid.Column="0"
                    Margin="8"
                    Background="#1F1F1F"
                    BorderBrush="#333"
                    BorderThickness="1"
                    ClipToBounds="True"
                    SizeChanged="ViewportHost_SizeChanged">
                <Grid x:Name="Viewport"
                      ClipToBounds="True"
                      Focusable="True"
                      MouseWheel="Viewport_MouseWheel"
                      MouseDown="Viewport_MouseDown"
                      MouseUp="Viewport_MouseUp"
                      MouseMove="Viewport_MouseMove"
                      MouseLeave="Viewport_MouseLeave"
                      KeyDown="Viewport_KeyDown"
                      KeyUp="Viewport_KeyUp">

                    <Canvas x:Name="World" RenderTransformOrigin="0,0">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="PanTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <!-- ★ 無限グリッド（キャンバスと独立。十分に巨大なサイズを敷く） -->
                        <Rectangle Canvas.Left="-5000000" Canvas.Top="-5000000"
                                   Width="10000000" Height="10000000"
                                   Fill="{StaticResource WorldGridBrush}"
                                   IsHitTestVisible="False"/>

                        <!-- キャンバス外周（半透明） -->
                        <Border
                            Canvas.Left="{Binding CanvasLeft}"
                            Canvas.Top="{Binding CanvasTop}"
                            Width="{Binding CanvasWidth}"
                            Height="{Binding CanvasHeight}"
                            Background="#12000000"
                            BorderBrush="#A0FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False"/>

                        <!-- キャンバス内のグリッド（少し明るめ） -->
                        <Rectangle
                            Canvas.Left="{Binding CanvasLeft}"
                            Canvas.Top="{Binding CanvasTop}"
                            Width="{Binding CanvasWidth}"
                            Height="{Binding CanvasHeight}"
                            Fill="{StaticResource CanvasGridBrush}"
                            IsHitTestVisible="False"/>

                        <!-- 実 UI を乗せる領域 -->
                        <Canvas x:Name="DesignCanvas"
                                Canvas.Left="{Binding CanvasLeft}"
                                Canvas.Top="{Binding CanvasTop}"
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                Background="Transparent"
                                ClipToBounds="True">

                            <ItemsControl ItemsSource="{Binding UIItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PosX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PosY}"/>
                                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding IsSelected, Converter={StaticResource BooleanToBrush}}"
                                                BorderThickness="{Binding IsSelected, Converter={StaticResource SelectedThickness}}"
                                                Background="#22000000"
                                                MouseLeftButtonDown="UIElement_MouseLeftButtonDown"
                                                MouseLeftButtonUp="UIElement_MouseLeftButtonUp"
                                                MouseMove="UIElement_MouseMove"
                                                Tag="{Binding}">
                                            <Grid RenderTransformOrigin="{Binding PivotPoint}">
                                                <Grid.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                                                        <RotateTransform Angle="{Binding Rotation}"/>
                                                    </TransformGroup>
                                                </Grid.RenderTransform>

                                                <Image x:Name="img"
                                                       Source="{Binding ImageSource}"
                                                       Width="{Binding DisplayWidth}"
                                                       Height="{Binding DisplayHeight}"
                                                       Opacity="{Binding Opacity}"
                                                       Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                                                       Stretch="Fill"/>
                                                <Grid x:Name="placeholder" Visibility="Collapsed"
                                                      Width="{Binding DisplayWidth}"
                                                      Height="{Binding DisplayHeight}">
                                                    <Rectangle Stroke="#88FFFFFF" StrokeDashArray="3 3" StrokeThickness="1" Fill="#22000000" RadiusX="2" RadiusY="2"/>
                                                    <TextBlock Text="NO IMAGE" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=img, Path=Source}" Value="{x:Null}">
                                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="img" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Canvas>

                    <!-- HUD -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8"
                            Background="#66000000" Padding="6" CornerRadius="4" IsHitTestVisible="False">
                        <TextBlock FontSize="12">
                            <Run Text="Zoom: "/>
                            <Run Text="{Binding ElementName=ZoomTransform, Path=ScaleX, StringFormat={}{0:P0}}"/>
                            <Run Text="  Pan: "/>
                            <Run Text="{Binding ElementName=PanTransform, Path=X, StringFormat={}{0}}"/>
                            <Run Text=", "/>
                            <Run Text="{Binding ElementName=PanTransform, Path=Y, StringFormat={}{0}}"/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="1" Margin="8" Padding="10" Background="#2a2c30" BorderBrush="#333" BorderThickness="1" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Inspector" FontSize="18" Margin="0,0,0,8"/>
                        <Separator/>

                        <TextBlock Text="Canvas" FontWeight="Bold" Margin="0,6,0,2"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="Name"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Data.CanvasName, Mode=TwoWay}"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="Left (Begin.X)"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CanvasLeft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Grid.Row="2" Grid.Column="0" Content="Top (Begin.Y)"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CanvasTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Grid.Row="3" Grid.Column="0" Content="Width"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CanvasWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Label Grid.Row="4" Grid.Column="0" Content="Height"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CanvasHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Separator/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                            <Button Content="＋ UI追加" Click="OnAddUIClick"/>
                            <Button Content="複製" Click="OnDuplicateUIClick"/>
                            <Button Content="削除" Click="OnDeleteUIClick"/>
                        </StackPanel>

                        <TextBlock Text="Selected UI" FontWeight="Bold" Margin="0,2,0,2"/>
                        <!-- 以降は前回と同じ（省略なしで置き換えOK） -->
                        <StackPanel DataContext="{Binding Selected}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="NAME"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NAME, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="GRAPHPATH"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GRAPH_PATH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="ANCHORPOINT"/>
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          ItemsSource="{Binding AnchorOptions}"
                                          SelectedItem="{Binding ANCHORPOINT, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="OFFSET X"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OFFSET_X_FROM_ANCHOR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="OFFSET Y"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OFFSET_Y_FROM_ANCHOR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="5" Grid.Column="0" Content="SRC (X,Y)"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="80" Text="{Binding GRAPH_SRC_X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="  " Width="6"/>
                                    <TextBox Width="80" Text="{Binding GRAPH_SRC_Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <Label Grid.Row="6" Grid.Column="0" Content="DEST (W,H)"/>
                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="80" Text="{Binding GRAPH_DEST_X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="  " Width="6"/>
                                    <TextBox Width="80" Text="{Binding GRAPH_DEST_Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <Label Grid.Row="7" Grid.Column="0" Content="INDEX (X,Y)"/>
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="80" Text="{Binding INDEX_X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="  " Width="6"/>
                                    <TextBox Width="80" Text="{Binding INDEX_Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <Label Grid.Row="8" Grid.Column="0" Content="DESCRIPTION"/>
                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding DESCRIPTION, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="9" Grid.Column="0" Content="Selectable"/>
                                <CheckBox Grid.Row="9" Grid.Column="1" IsChecked="{Binding IS_SELECTABLE, Mode=TwoWay}"/>

                                <Label Grid.Row="10" Grid.Column="0" Content="Visible"/>
                                <CheckBox Grid.Row="10" Grid.Column="1" IsChecked="{Binding IsVisible, Mode=TwoWay}"/>

                                <Label Grid.Row="11" Grid.Column="0" Content="Rotation"/>
                                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Rotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="12" Grid.Column="0" Content="Scale"/>
                                <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding Scale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="13" Grid.Column="0" Content="Opacity"/>
                                <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="14" Grid.Column="0" Content="ZIndex"/>
                                <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding ZIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Label Grid.Row="15" Grid.Column="0" Content="LockAspect"/>
                                <CheckBox Grid.Row="15" Grid.Column="1" IsChecked="{Binding LockAspectRatio, Mode=TwoWay}"/>

                                <Label Grid.Row="16" Grid.Column="0" Content="Pivot (X,Y)"/>
                                <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Width="80" Text="{Binding PivotX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="  " Width="6"/>
                                    <TextBox Width="80" Text="{Binding PivotY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <Label Grid.Row="17" Grid.Column="0" Content="Display Image (editor)"/>
                                <DockPanel Grid.Row="17" Grid.Column="1">
                                    <TextBox x:Name="tbDisplayImage" DockPanel.Dock="Left" Text="{Binding DisplayImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Content="参照..." Width="64" Click="OnBrowseDisplayImageClick"/>
                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
