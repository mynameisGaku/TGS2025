<UserControl x:Class="MainCanvasEditor.DragNumeric"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="60" MinHeight="22">
    <Border x:Name="Root" BorderBrush="#333" BorderThickness="1" Background="#1E1F22" Padding="0">
        <Grid>
            <TextBox x:Name="Box"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#F0F0F0"
                     Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, StringFormat={}{0:G}, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalContentAlignment="Right"
                     Padding="4,2,4,2"/>
            <!-- ドラッグ用レイヤ（テキスト入力中はドラッグしない） -->
            <Rectangle x:Name="DragLayer" Fill="#00000000" IsHitTestVisible="True"/>
        </Grid>
    </Border>
</UserControl>
